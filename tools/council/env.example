# Council provider configuration.
#
# Copy this file to `.env.council` next to it and fill in the values. `.env.council` is
# gitignored and must never be committed, copied into an image, or placed on the server:
# the council CLI only ever runs offline on the owner's machine.
#
# Real environment variables win over this file, and `--models` wins over COUNCIL_MODELS.
# The file is read by `src/config.ts`; nothing here is read by the app at runtime.

# One `provider:model` id per line entry, comma separated. 3-5 models from different
# vendors gives real diversity; 2 is the floor the reviewer queue can still be ordered by.
# Model ids other than anthropic:claude-sonnet-5-5 are placeholders chosen at M3 from the
# current provider catalogues.
COUNCIL_MODELS=anthropic:claude-sonnet-5-5,openai:gpt-6-mini,google:gemini-3-flash,mistral:mistral-medium-3

# Below this many successful models in either phase the run is refused: no candidates.jsonl
# is written and the manifest is kept with status "failed".
COUNCIL_MIN_MODELS=2

# Per-request timeout, seconds, and sampling temperature for both phases.
COUNCIL_TIMEOUT_S=300
COUNCIL_TEMPERATURE=0.4

# Per-vendor keys. Either four vendor keys:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
# or one OpenRouter key used with openrouter:<vendor>/<model> ids:
OPENROUTER_API_KEY=
