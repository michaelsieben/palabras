<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Build identity, part 1 of 2 (the other half is CommitSha below). This file is the single
         place that defines the version and the milestone; /healthz and the Ajustes screen read them
         from the assembly, so nothing else may repeat a literal. Bump Version on a release decision
         and Milestone when the milestone in docs/00-handoff.md §7 changes. -->
    <Version>0.7.0</Version>
    <Milestone>M7</Milestone>
    <!-- Supplied by the image/CI build (-p:CommitSha=<sha>); never hardcoded. Empty means nobody
         told us which commit this is, and the app then reports "unknown" instead of guessing. -->
    <CommitSha Condition="'$(CommitSha)' == ''">unknown</CommitSha>
    <!-- Keep the informational version clean: the sha is reported from CommitSha only, so a future
         SourceLink addition cannot make two different values claim to be the build identity. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="CommitSha" Value="$(CommitSha)" />
    <AssemblyMetadata Include="Milestone" Value="$(Milestone)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fsrs.Sharp" Version="[2.0.0]" />
    <PackageReference Include="JsonSchema.Net" Version="[7.4.0]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!-- Patched native SQLite; EF's default transitive 2.1.11 has GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <InternalsVisibleTo Include="Palabras.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../content/schema/word.schema.json" Link="content/schema/word.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The council bundle contract is committed once and validated by both the CLI and the importer. -->
    <Content Include="../../content/schema/council-manifest.schema.json" Link="content/schema/council-manifest.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../content/schema/council-candidate.schema.json" Link="content/schema/council-candidate.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Council bundles are runtime data for ContentSyncService (startup sync, propose only). Raw
         provider payloads are debug data and must never reach publish/ or the image. -->
    <Content Include="../../content/council/**/*.json" Exclude="../../content/council/**/raw/**" Link="content/council/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../content/council/**/*.jsonl" Exclude="../../content/council/**/raw/**" Link="content/council/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Local dotnet run and the test project keep the development settings; a published image must not ship them. -->
    <Content Update="appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
