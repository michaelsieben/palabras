# Configuration only. Accounts are created by /app/Palabras user create, never seeded here.
# Optional explicit SQLite path; overrides DATA_DIR (default /data) + palabras.db.
ConnectionStrings__Default=Data Source=/data/palabras.db
TZ=Europe/Amsterdam

# Reserved through M8. Not consumed by M0; fill only when corresponding milestone lands.
APP_BASE_URL=https://palabras.example.invalid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.invalid
FALLBACK_NOTIFY_URL=
BACKUP_RETENTION_DAYS=14

# M7 day rollover gate (config key M7:DayRolloverEnabled). Default false; only the literal
# `true` enables it. The schema migrates regardless; while off no `missed` history is written.
# Leave unset: enabling is a deliberate decision gated on the outstanding pre-enablement items
# (docs/07-learn-api.md "Rollover and missed days", docs/08-upgrade-rollback.md section D).
# M7__DayRolloverEnabled=false

# Consumed by Compose: host port and container listen port, default 18480 (unused on the host).
APP_PORT=18480
# Local dev: blank uses ./data. Unraid: /mnt/cache/appdata/palabras (cache pool path; avoid
# /mnt/user/appdata, the shfs/FUSE layer, which risks SQLite locking and corruption).
# Set BEFORE first deploy; changing later requires moving the DB file manually.
APPDATA_PATH=
