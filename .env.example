# M0: only ASPNETCORE_URLS affects app behavior; DB is a placeholder.
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__Default=Data Source=/data/palabras.db
TZ=Europe/Amsterdam

# Reserved through M8. Not consumed by M0; fill only when corresponding milestone lands.
APP_BASE_URL=https://palabras.example.invalid
OWNER_USERNAME=owner
OWNER_INITIAL_PASSWORD=
REVIEWER_USERNAME=reviewer
REVIEWER_INITIAL_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.invalid
FALLBACK_NOTIFY_URL=
BACKUP_RETENTION_DAYS=14
FORWARDED_KNOWN_NETWORK=

# Deployment placeholders from design. Compose currently uses a named volume,
# local image, fixed loopback port and isolated default network; these are not wired yet.
APPDATA=/mnt/user/appdata/palabras
PROXY_NETWORK=
PALABRAS_TAG=local
